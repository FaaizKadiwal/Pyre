# Copy to .env for local development. Node 20.6+ can load it with:
#   node --env-file=.env server/server.js
# Hosting platforms set these in their dashboard instead.

# Port to listen on. Render, Koyeb, Fly and Docker set this for you.
PORT=3000

# Optional. Postgres connection string for persistent game results and the
# leaderboard. Leave unset to keep results in memory (lost on restart).
# Neon / Supabase example:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# production | development
NODE_ENV=development
